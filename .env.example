# Mahjong-only build-time configuration. Set this to a raw JSON URL (for
# example, a GitHub Gist) to provide multiple default BGM, optional riichi
# BGM, tablecloth, table-background, lobby-background, tile-back, and portrait
# assets. Omit `riichiBgm` to keep the match BGM playing after riichi.
MAHJONG_DEFAULT_ASSET_CONFIG_URL=
