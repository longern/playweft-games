{
  "$schema": "https://play.longern.com/schemas/game-manifest-v1.json",
  "manifestVersion": 1,
  "id": "com.longern.playweft.connect-four",
  "version": "1.0.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "client": {
    "entry": "./"
  },
  "name": "Connect Four",
  "name_localized": {
    "zh-CN": "四子棋"
  },
  "description": "Connect four pieces in a row before your opponent does.",
  "description_localized": {
    "zh-CN": "横、竖或斜线连成四子，抢在对手之前占据棋盘。"
  },
  "categories": [
    "Strategy"
  ],
  "icons": [
    {
      "src": "../connect-four.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "background_color": "#f4f5f1",
  "theme_color": "#2463eb",
  "help_url": "./help.html",
  "modes": {
    "room": {
      "players": {
        "min": 2,
        "max": 2
      },
      "server": {
        "runtime": "lua",
        "entry": "./game.lua",
        "persistence": "durable"
      }
    }
  }
}
