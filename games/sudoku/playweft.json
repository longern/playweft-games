{
  "$schema": "https://playweft.dev/schemas/game-manifest-v1.json",
  "manifestVersion": 1,
  "id": "com.longern.playweft.sudoku",
  "version": "1.0.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "client": {
    "entry": "./"
  },
  "name": "Sudoku",
  "name_localized": {
    "zh-CN": "数独"
  },
  "description": "Solve a uniquely generated grid at your preferred difficulty.",
  "description_localized": {
    "zh-CN": "选择难度，挑战一道拥有唯一解的数独。"
  },
  "categories": [
    "Puzzle"
  ],
  "icons": [
    {
      "src": "../sudoku.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "background_color": "#f5f5f0",
  "theme_color": "#1e6e59",
  "help_url": "./help.html",
  "modes": {
    "solo": {}
  }
}
