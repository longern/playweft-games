{
  "$schema": "https://playweft.dev/schemas/game-manifest-v1.json",
  "manifestVersion": 1,
  "id": "com.longern.playweft.sudoku",
  "version": "1.0.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "client": {
    "entry": "./"
  },
  "display": {
    "defaultLocale": "en",
    "locales": {
      "en": {
        "name": "Sudoku",
        "description": "Solve a uniquely generated grid at your preferred difficulty.",
        "category": "Puzzle"
      },
      "zh-CN": {
        "name": "数独",
        "description": "选择难度，挑战一道拥有唯一解的数独。",
        "category": "益智"
      }
    },
    "icon": "../sudoku.svg",
    "help": "./help.html"
  },
  "modes": {
    "solo": {}
  }
}
