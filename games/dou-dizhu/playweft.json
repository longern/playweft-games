{
  "$schema": "https://play.longern.com/schemas/game-manifest-v1.json",
  "manifest_version": 1,
  "id": "/dou-dizhu/",
  "version": "1.0.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "start_url": "./",
  "name": "Dou Dizhu",
  "name_localized": {
    "zh-CN": "斗地主"
  },
  "description": "Bid for the landlord and be the first team to play every card.",
  "description_localized": {
    "zh-CN": "叫分定地主，灵活配合出牌，率先出完手牌获胜。"
  },
  "categories": [
    "Card game"
  ],
  "icons": [
    {
      "src": "../dou-dizhu.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "background_color": "#f4f5f1",
  "theme_color": "#1e664b",
  "orientation": "landscape",
  "help_url": "./help.html",
  "modes": {
    "solo": {},
    "room": {
      "players": {
        "min": 3,
        "max": 3
      },
      "server": {
        "runtime": "lua",
        "entry": "./game.lua",
        "persistence": "durable"
      }
    }
  }
}
