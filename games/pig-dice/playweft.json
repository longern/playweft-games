{
  "$schema": "https://play.longern.com/schemas/game-manifest-v1.json",
  "manifest_version": 1,
  "id": "/pig-dice/",
  "version": "1.0.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "start_url": "./",
  "name": "Pig Dice",
  "name_localized": {
    "zh-CN": "贪心骰子"
  },
  "description": "Roll for points, bank them in time, and beware of losing the turn's haul.",
  "description_localized": {
    "zh-CN": "掷骰冲分，见好就收，小心一掷清零。"
  },
  "categories": [
    "Quick match"
  ],
  "icons": [
    {
      "src": "../pig-dice.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "background_color": "#f4f5f1",
  "theme_color": "#ef5b4c",
  "help_url": "./help.html",
  "modes": {
    "room": {
      "players": {
        "min": 2,
        "max": 2
      },
      "server": {
        "runtime": "lua",
        "entry": "./game.lua",
        "persistence": "durable"
      }
    }
  }
}
