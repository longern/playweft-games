{
  "$schema": "https://playweft.dev/schemas/game-manifest-v1.json",
  "manifestVersion": 1,
  "id": "com.longern.playweft.gomoku",
  "version": "1.0.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "client": {
    "entry": "./"
  },
  "name": "Gomoku",
  "name_localized": {
    "zh-CN": "五子棋"
  },
  "description": "Take turns placing stones and be first to connect five.",
  "description_localized": {
    "zh-CN": "黑白轮流落子，率先横、竖或斜线连成五子获胜。"
  },
  "categories": ["Strategy"],
  "icons": [
    {
      "src": "../gomoku.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "background_color": "#f4f5f1",
  "theme_color": "#d9aa63",
  "help_url": "./help.html",
  "modes": {
    "room": {
      "players": {
        "min": 2,
        "max": 2
      },
      "server": {
        "runtime": "lua",
        "entry": "./game.lua",
        "persistence": "durable"
      }
    }
  }
}
