{
  "$schema": "https://playweft.dev/schemas/game-manifest-v1.json",
  "manifestVersion": 1,
  "id": "com.longern.playweft.go",
  "version": "1.0.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "client": {
    "entry": "./"
  },
  "display": {
    "defaultLocale": "en",
    "locales": {
      "en": {
        "name": "Go",
        "description": "Play locally or online, claiming territory and capturing stones.",
        "category": "Strategy"
      },
      "zh-CN": {
        "name": "围棋",
        "description": "支持本机轮流或双人房间对弈，围地、提子并通过计分决出胜负。",
        "category": "策略"
      }
    },
    "icon": "../go.svg",
    "help": "./help.html"
  },
  "modes": {
    "solo": {},
    "room": {
      "players": {
        "min": 2,
        "max": 2
      },
      "server": {
        "runtime": "lua",
        "entry": "./game.lua",
        "persistence": "durable"
      }
    }
  }
}
