{
  "$schema": "https://play.longern.com/schemas/game-manifest-v1.json",
  "manifest_version": 1,
  "id": "/go/",
  "version": "1.0.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "start_url": "./",
  "name": "Go",
  "name_localized": {
    "zh-CN": "围棋"
  },
  "description": "Play locally or online, claiming territory and capturing stones.",
  "description_localized": {
    "zh-CN": "支持本机轮流或双人房间对弈，围地、提子并通过计分决出胜负。"
  },
  "categories": [
    "Strategy"
  ],
  "icons": [
    {
      "src": "../go.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "background_color": "#f1f1ed",
  "theme_color": "#d6a260",
  "help_url": "./help.html",
  "modes": {
    "solo": {},
    "room": {
      "players": {
        "min": 2,
        "max": 2
      },
      "server": {
        "runtime": "lua",
        "entry": "./game.lua",
        "persistence": "durable"
      }
    }
  }
}
