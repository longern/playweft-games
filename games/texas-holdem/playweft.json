{
  "$schema": "https://play.longern.com/schemas/game-manifest-v1.json",
  "manifest_version": 1,
  "id": "/texas-holdem/",
  "version": "1.0.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "start_url": "./",
  "name": "Texas Hold'em",
  "name_localized": {
    "zh-CN": "德州扑克"
  },
  "description": "Read the table, bet boldly, and bluff your way to the pot.",
  "description_localized": {
    "zh-CN": "看牌下注，大胆加注或巧妙诈唬，赢下桌上底池。"
  },
  "categories": [
    "Card game"
  ],
  "icons": [
    {
      "src": "../texas-holdem.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "background_color": "#edf2ed",
  "theme_color": "#1b7757",
  "help_url": "./help.html",
  "modes": {
    "room": {
      "players": {
        "min": 2,
        "max": 6
      },
      "server": {
        "runtime": "lua",
        "entry": "./game.lua",
        "persistence": "durable"
      }
    }
  }
}
