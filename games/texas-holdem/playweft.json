{
  "$schema": "https://play.longern.com/schemas/game-manifest-v1.json",
  "manifestVersion": 1,
  "id": "com.longern.playweft.texas-holdem",
  "version": "1.0.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "client": {
    "entry": "./"
  },
  "name": "Texas Hold'em",
  "name_localized": {
    "zh-CN": "德州扑克"
  },
  "description": "Bet, raise, and bluff at a table for two to six players.",
  "description_localized": {
    "zh-CN": "下注、加注与诈唬，在二至六人牌桌上争夺底池。"
  },
  "categories": [
    "Card game"
  ],
  "icons": [
    {
      "src": "../texas-holdem.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "background_color": "#edf2ed",
  "theme_color": "#1b7757",
  "help_url": "./help.html",
  "modes": {
    "room": {
      "players": {
        "min": 2,
        "max": 6
      },
      "server": {
        "runtime": "lua",
        "entry": "./game.lua",
        "persistence": "durable"
      }
    }
  }
}
