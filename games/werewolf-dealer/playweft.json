{
  "$schema": "https://play.longern.com/schemas/game-manifest-v1.json",
  "manifestVersion": 1,
  "id": "com.longern.playweft.werewolf-dealer",
  "version": "1.2.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "client": {
    "entry": "./"
  },
  "name": "Werewolf Dealer",
  "name_localized": {
    "zh-CN": "狼人杀发牌器"
  },
  "description": "Deal configurable secret-role presets locally on one phone or in an online room.",
  "description_localized": {
    "zh-CN": "支持单机或在线房间自选版型、配置身份池并分配隐藏角色。"
  },
  "categories": [
    "Party"
  ],
  "icons": [
    {
      "src": "../werewolf-dealer.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "background_color": "#06101e",
  "theme_color": "#050d19",
  "help_url": "./help.html",
  "modes": {
    "solo": {},
    "room": {
      "players": {
        "min": 6,
        "max": 12
      },
      "server": {
        "runtime": "lua",
        "entry": "./game.lua",
        "persistence": "durable"
      }
    }
  }
}
