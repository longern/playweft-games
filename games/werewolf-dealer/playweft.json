{
  "$schema": "https://playweft.dev/schemas/game-manifest-v1.json",
  "manifestVersion": 1,
  "id": "com.longern.playweft.werewolf-dealer",
  "version": "1.1.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "client": {
    "entry": "./"
  },
  "name": "Werewolf Dealer",
  "name_localized": {
    "zh-CN": "狼人杀发牌器"
  },
  "description": "Deal secret roles locally on one phone or run an online social deduction room.",
  "description_localized": {
    "zh-CN": "支持一台手机轮流查看身份，也可在线分配隐藏角色、收集投票并组织狼人杀。"
  },
  "categories": ["Party"],
  "icons": [
    {
      "src": "../werewolf-dealer.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "background_color": "#f4f5f1",
  "theme_color": "#312927",
  "help_url": "./help.html",
  "modes": {
    "solo": {},
    "room": {
      "players": {
        "min": 6,
        "max": 12
      },
      "server": {
        "runtime": "lua",
        "entry": "./game.lua",
        "persistence": "durable"
      }
    }
  }
}
