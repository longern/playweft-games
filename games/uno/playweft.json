{
  "$schema": "https://playweft.dev/schemas/game-manifest-v1.json",
  "manifestVersion": 1,
  "id": "com.longern.playweft.uno",
  "version": "1.0.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "client": {
    "entry": "./"
  },
  "name": "UNO",
  "name_localized": {
    "zh-CN": "UNO"
  },
  "description": "Match colours and numbers to empty your hand before everyone else.",
  "description_localized": {
    "zh-CN": "匹配颜色或数字，善用功能牌，抢先打完所有手牌。"
  },
  "categories": ["Card game"],
  "icons": [
    {
      "src": "../uno.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "background_color": "#f1f3ee",
  "theme_color": "#e2463e",
  "help_url": "./help.html",
  "modes": {
    "room": {
      "players": {
        "min": 2,
        "max": 4
      },
      "server": {
        "runtime": "lua",
        "entry": "./game.lua",
        "persistence": "durable"
      }
    }
  }
}
