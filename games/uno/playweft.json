{
  "$schema": "https://playweft.dev/schemas/game-manifest-v1.json",
  "manifestVersion": 1,
  "id": "com.longern.playweft.uno",
  "version": "1.0.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "client": {
    "entry": "./"
  },
  "display": {
    "defaultLocale": "en",
    "locales": {
      "en": {
        "name": "UNO",
        "description": "Match colours and numbers to empty your hand before everyone else.",
        "category": "Card game"
      },
      "zh-CN": {
        "name": "UNO",
        "description": "匹配颜色或数字，善用功能牌，抢先打完所有手牌。",
        "category": "纸牌"
      }
    },
    "icon": "../uno.svg",
    "help": "./help.html"
  },
  "modes": {
    "room": {
      "players": {
        "min": 2,
        "max": 4
      },
      "server": {
        "runtime": "lua",
        "entry": "./game.lua",
        "persistence": "durable"
      }
    }
  }
}
