{
  "$schema": "https://play.longern.com/schemas/game-manifest-v1.json",
  "manifest_version": 1,
  "id": "/uno/",
  "version": "1.0.0",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "start_url": "./",
  "name": "UNO",
  "name_localized": {
    "zh-CN": "UNO"
  },
  "description": "Match colours or numbers and use action cards to turn the game around.",
  "description_localized": {
    "zh-CN": "颜色或数字对上就能出牌，功能牌随时让局势反转。"
  },
  "categories": [
    "Card game"
  ],
  "icons": [
    {
      "src": "../uno.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "background_color": "#f1f3ee",
  "theme_color": "#e2463e",
  "help_url": "./help.html",
  "modes": {
    "room": {
      "players": {
        "min": 2,
        "max": 4
      },
      "server": {
        "runtime": "lua",
        "entry": "./game.lua",
        "persistence": "durable"
      }
    }
  }
}
